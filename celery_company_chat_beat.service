[Unit]
Description=Beat celery for company_chat
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/www/yue/company_chat

ExecStart=/www/miniconda3/envs/companychat/bin/celery -A company_chat.celery_app beat --loglevel=INFO


Restart=on-failure
RestartSec=10


StandardOutput=append:/var/log/celery/out-company_chat_beat.log
StandardError=append:/var/log/celery/err-company_chat_beat.log

[Install]
WantedBy=multi-user.target
